# Database (Neon — copy connection string from Neon dashboard, includes ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/repair_ai?sslmode=require

# Hugging Face (free, open-source LLM for explanation layer)
# Get a free token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here

# Any instruct model served by an HF Inference Provider works (chat-completions API).
# flan-t5-large and other old serverless-only models are no longer served — use a
# current instruct model instead. Check what's live for your token at
# https://huggingface.co/settings/inference-providers
HF_MODEL=openai/gpt-oss-120b
